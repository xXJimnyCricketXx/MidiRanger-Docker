DJANGO_SECRET_KEY=ChangeThisToAComplexSecret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Admin-Account, wird von "python manage.py seed" angelegt (nur falls er noch nicht existiert)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Host-Port, unter dem die Weboberfläche erreichbar ist (z.B. http://<Server>:8000).
PORT=8000

# ALSA-Name (oder Teilstring) des MIDI-Ausgabegeräts, z.B. "UM-ONE".
# Leer lassen, um automatisch den ersten passenden Ausgabe-Port zu wählen.
MIDI_OUTPUT_NAME=

# --- Nur für docker-compose (Volume-Quellen auf dem Host) -----------------
# Ordner für DB/Logs/Backups, z.B. ./appdata oder /mnt/user/appdata/midiranger
APPDATA_PATH=./appdata
# Bestehender midi/-Ordner (originals/uploads/lyrics/mixer_output), kann auf
# einem beliebigen Share liegen, z.B. /mnt/user/cricketstudio/MIDI
MIDI_PATH=./midi
